<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:elevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:rippleColor="@android:color/transparent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 👤 CUSTOMER INFO ROW -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Avatar Circle -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_call"
                android:scaleType="centerInside"
                app:tint="#FFFFFF"
                android:background="#3B82F6"
                android:padding="8dp"
                app:shapeAppearanceOverlay="@style/RoundedImageView"
                android:contentDescription="Customer Avatar"/>

            <!-- Name and Mobile -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtCustomerName"
                    android:text="John Doe"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1B4B5C"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtMobile"
                    android:text="9876543210"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- Amount Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#ECFDF5"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/txtAmount"
                    android:text="₹1,250"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#16A34A"
                    android:padding="8dp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 📅 DATE AND STATUS -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#94A3B8"
                    android:contentDescription="Date"/>

                <TextView
                    android:id="@+id/txtDate"
                    android:text="16 Feb 2026"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#10B981"
                    android:contentDescription="Status"/>

                <TextView
                    android:id="@+id/txtStatus"
                    android:text="Completed"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

        <!-- 🔘 ACTION BUTTONS -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            tools:ignore="DisableBaselineAlignment">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpen"
                android:text="Open"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3B82F6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#3B82F6"
                tools:ignore="TouchTargetSizeCheck"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReprint"
                android:text="Reprint"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#10B981"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#10B981"
                tools:ignore="TouchTargetSizeCheck"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:text="Delete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EF4444"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#EF4444"
                tools:ignore="TouchTargetSizeCheck"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>