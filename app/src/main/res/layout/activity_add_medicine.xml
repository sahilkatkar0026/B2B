<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_medical"
                app:tint="#2563EB"
                android:contentDescription="Medical Icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Medicine"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

        <!-- Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Medicine Image -->
                <ImageView
                    android:id="@+id/imgMedicine"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/upload"
                    android:contentDescription="Medicine Image"/>

                <!-- Pick Image Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Select Medicine Image"
                    app:cornerRadius="10dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Medicine Name Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Medicine Name"
                    app:startIconDrawable="@drawable/ic_medication"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Brand Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Brand / Manufacturer"
                    app:startIconDrawable="@drawable/ic_business"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Price (₹)"
                    app:startIconDrawable="@drawable/ic_currency"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    app:prefixText="₹ "
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stock Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Stock Quantity"
                    app:startIconDrawable="@drawable/ic_inventory"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    app:suffixText=" units"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Manufacturing Date Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Manufacturing Date"
                    app:startIconDrawable="@drawable/ic_medication"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMfgDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Expiry Date Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Expiry Date"
                    app:startIconDrawable="@drawable/ic_medication"
                    app:startIconTint="#64748B"
                    app:boxStrokeColor="#2563EB"
                    app:hintTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpiryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:textColor="#1E293B"
                        android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Add Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Add Medicine"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#2563EB"
                    android:textColor="#FFFFFF"
                    app:elevation="4dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Info Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/info_background"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info"
                app:tint="#3B82F6"
                android:contentDescription="Info"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ensure all medicine details are accurate before adding"
                android:textSize="13sp"
                android:textColor="#475569"
                android:layout_marginStart="12dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>