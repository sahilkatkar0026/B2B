<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Medicine"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="20dp" />

        <!-- Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <!-- Medicine Image -->
                <ImageView
                    android:id="@+id/imgMedicine"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/upload"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Image"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#3B82F6"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    app:cornerRadius="10dp"/>
                <!-- Medicine Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Medicine Name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Brand -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Brand / Manufacturer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Price (₹)"
                    app:prefixText="₹ "
                    app:prefixTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Stock -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Stock Quantity"
                    app:suffixText=" units"
                    app:suffixTextColor="#2563EB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Manufacturing Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Manufacturing Date (yyyy-mm-dd)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMfgDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Expiry Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Expiry Date (yyyy-mm-dd)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etExpiryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#94A3B8"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Update Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#2563EB"
                    android:text="Update Medicine"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#5B8DBE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>