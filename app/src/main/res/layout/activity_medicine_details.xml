<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- HEADER SECTION -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRODUCT DETAILS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medicine Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <!-- Category Badge -->
            <androidx.cardview.widget.CardView
                android:id="@+id/categoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#DBEAFE">

                <TextView
                    android:id="@+id/txtCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#1E40AF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Medicine"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- MEDICINE IMAGE CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#E0F2FE"
            android:layout_marginTop="8dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toBottomOf="@id/headerSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F0F9FF">

                <!-- Medicine Image -->
                <ImageView
                    android:id="@+id/ivMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_medicine_placeholder"
                    android:scaleType="centerInside"
                    android:contentDescription="Medicine Image"
                    android:padding="20dp"/>

                <!-- Stock Badge Overlay -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/stockBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#10B981">

                    <TextView
                        android:id="@+id/txtStockBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:text="In Stock"/>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- MEDICINE NAME -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Medicine Name"/>

        <!-- BRAND WITH ICON -->
        <LinearLayout
            android:id="@+id/brandLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#64748B"
                android:layout_marginEnd="8dp"
                android:contentDescription="Brand Icon"/>

            <TextView
                android:id="@+id/txtBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:text="Brand Name"/>

        </LinearLayout>

        <!-- MFG & EXPIRY DATES -->
        <LinearLayout
            android:id="@+id/dateLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/brandLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtMfg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MFG: --"
                android:textSize="13sp"
                android:textColor="#334155"/>

            <TextView
                android:id="@+id/txtExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expiry: --"
                android:textSize="13sp"
                android:textColor="#DC2626"/>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/dateLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PRICING SECTION HEADER -->
        <TextView
            android:id="@+id/lblPricing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRICING AND STOCK"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:letterSpacing="0.1"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- PRICE AND STOCK CONTAINER -->
        <LinearLayout
            android:id="@+id/priceStockContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/lblPricing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- PRICE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit Price"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#3B82F6"
                    android:layout_marginTop="4dp"
                    android:text="₹0"/>

            </LinearLayout>

            <!-- STOCK INFO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Stock"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:layout_marginTop="4dp"
                    android:text="0 Units"/>

            </LinearLayout>

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/priceStockContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ORDER SECTION HEADER -->
        <TextView
            android:id="@+id/lblOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORDER QUANTITY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:letterSpacing="0.1"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- QUANTITY SELECTOR CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/quantityCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/lblOrder"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="6dp">

                <!-- MINUS BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:backgroundTint="#CBD5E1"
                    android:textColor="#475569"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- QUANTITY DISPLAY -->
                <TextView
                    android:id="@+id/txtQty"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:gravity="center"
                    android:text="0"/>

                <!-- PLUS BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF"
                    app:iconPadding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TOTAL AMOUNT PREVIEW -->
        <LinearLayout
            android:id="@+id/totalPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@id/quantityCard"
            app:layout_constraintBottom_toBottomOf="@id/quantityCard"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Amount"
                android:textSize="11sp"
                android:textColor="#94A3B8"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:layout_marginTop="4dp"
                android:text="₹0"/>

        </LinearLayout>

        <!-- ADD TO CART BUTTON -->

        <!-- BOTTOM SPACER -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrder"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="44dp"
            android:elevation="4dp"
            android:text="Add to Cart"
            android:textColor="#FFFFFF"
            app:backgroundTint="#5B8DBE"
            android:textSize="17sp"
            android:textStyle="bold"

            app:cornerRadius="16dp"
            app:icon="@drawable/ic_shopping_cart"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quantityCard" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnOrder"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>