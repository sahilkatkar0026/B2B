<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- =========================================
             TOP SECTION: Image (Centered, Full Width)
             ========================================= -->
        <ImageView
            android:id="@+id/imgMedicine"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_medicine_placeholder"
            android:scaleType="centerInside"
            android:contentDescription="Medicine Image"
            android:background="#E8F0FE"
            android:padding="12dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <!-- =========================================
             MIDDLE SECTION: Name & Brand
             ========================================= -->
        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Paracetamol"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="start"/>

        <TextView
            android:id="@+id/txtBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brand: N/A"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>

        <!-- =========================================
             DATES & DETAILS (Compact)
             ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MFG:"
                android:textSize="9sp"
                android:textColor="#94A3B8"/>

            <TextView
                android:id="@+id/txtMfg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="N/A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXP:"
                android:textSize="9sp"
                android:textColor="#94A3B8"/>

            <TextView
                android:id="@+id/txtExpiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="N/A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#EF4444"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- =========================================
             PRICE & STOCK (Side by Side)
             ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textSize="9sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/txtPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2563EB"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:textSize="9sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/txtStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#16A34A"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- =========================================
             ADD BUTTON (Full Width)
             ========================================= -->
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Add"
            app:backgroundTint="#3B82F6"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#3B82F6"
            android:backgroundTint="#3B82F6"
            android:layout_gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>