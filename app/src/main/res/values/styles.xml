<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 🎨 APPLICATION THEME -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryVariant">#1E40AF</item>
        <item name="colorSecondary">#10B981</item>
        <item name="colorSecondaryVariant">#059669</item>
    </style>

    <!-- 🔵 ROUNDED IMAGE VIEW STYLE -->
    <style name="RoundedImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance" parent="TextAppearance.MaterialComponents.Body1" />

    <!-- 📝 TEXT APPEARANCE STYLES -->

    <!-- Large Headline -->
    <style name="TextAppearance.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1B4B5C</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Subtitle Text -->
    <style name="TextAppearance.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">#64748B</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Body Text -->
    <style name="TextAppearance.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">#1E293B</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Success/Green Text -->
    <style name="TextAppearance.Success">
        <item name="android:textColor">#16A34A</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Info/Blue Text -->
    <style name="TextAppearance.Info">
        <item name="android:textColor">#3B82F6</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Danger/Red Text -->
    <style name="TextAppearance.Danger">
        <item name="android:textColor">#EF4444</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ⚪ CARD STYLES -->

    <!-- Standard Card -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>

    <!-- 🔘 BUTTON STYLES -->

    <!-- Primary Button -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">#3B82F6</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Outlined Button Blue -->
    <style name="Button.Outlined.Blue" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#3B82F6</item>
        <item name="android:textColor">#3B82F6</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Outlined Button Green -->
    <style name="Button.Outlined.Green" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#10B981</item>
        <item name="android:textColor">#10B981</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Outlined Button Red -->
    <style name="Button.Outlined.Red" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#EF4444</item>
        <item name="android:textColor">#EF4444</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- 🎨 COLOR DEFINITIONS -->
    <style name="ColorPrimary">
        <item name="android:textColor">#3B82F6</item>
    </style>

    <style name="ColorSuccess">
        <item name="android:textColor">#16A34A</item>
    </style>

    <style name="ColorWarning">
        <item name="android:textColor">#F59E0B</item>
    </style>

    <style name="ColorDanger">
        <item name="android:textColor">#EF4444</item>
    </style>

</resources>